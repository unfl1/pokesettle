# Copy to .env.production on the deployment host; never commit real values.
# Use a unique URL-safe password, e.g. Python secrets.token_hex(32).
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5.6-luna
DATABASE_SCHEMA=poketact
ALLOWED_ORIGINS=http://127.0.0.1:5173
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_TIMEOUT_SECONDS=60
MAX_RETRIES=1
LANGSMITH_TRACING=false
# Anonymous session/IP admission; UTC day, persistent PostgreSQL counters.
USAGE_REQUESTS_PER_MINUTE=3
USAGE_REQUESTS_PER_DAY=200
USAGE_IP_REQUESTS_PER_DAY=400
USAGE_GLOBAL_CONCURRENCY=2
USAGE_CALLS_PER_JOB=8
# Conservative reservations, including failed attempts; not actual billing tokens.
# GPT-5.6 Luna ceiling: 2450000; GPT-6 Luna fallback: 230000, separate daily groups.
USAGE_DAILY_TOKENS=2450000
USAGE_DAILY_CALLS=1000
MODEL_MAX_INPUT_TOKENS=24000
MODEL_MAX_OUTPUT_TOKENS=2000

# 선택 GA4 측정 ID. 프런트엔드 서버 요청 시 읽기
GA_ID=

# GPT-6 Luna fallback daily cap; independent from the primary model group.
USAGE_FALLBACK_DAILY_TOKENS=230000
