# Install in /etc/nginx/conf.d after replacing domain/certificate placeholders.
# The origin token include is generated separately with root-only permissions.
limit_req_zone $binary_remote_addr zone=api_reads:10m rate=10r/s;
# CloudFront appends the actual viewer IP as the final X-Forwarded-For entry.
# Trust this only after validating the private origin token below.
map $http_x_forwarded_for $usage_viewer_ip {
    default "";
    ~(?:^|,\s*)(?<usage_last_address>[0-9a-fA-F:.]+)\s*$ $usage_last_address;
}
map $request_method $write_limit_key {
    default "";
    POST $server_name;
    PUT $server_name;
    PATCH $server_name;
    DELETE $server_name;
}
limit_req_zone $write_limit_key zone=api_writes:1m rate=30r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 404; }
}

server {
    listen 80;
    listen [::]:80;
    server_name __ROOT_DOMAIN__;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 308 https://www.__ROOT_DOMAIN__$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __ROOT_DOMAIN__;
    ssl_certificate __CERTIFICATE_PATH__/fullchain.pem;
    ssl_certificate_key __CERTIFICATE_PATH__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    return 308 https://www.__ROOT_DOMAIN__$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.__ROOT_DOMAIN__;
    ssl_certificate __CERTIFICATE_PATH__/fullchain.pem;
    ssl_certificate_key __CERTIFICATE_PATH__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 64k;
    limit_req_status 429;
    # Sets $valid_origin_token from X-PokeTact-Origin; never commit its value.
    include /etc/nginx/poketact-private/origin-token.conf;
    location /api/ {
        if ($valid_origin_token = 0) { return 403; }
        limit_req zone=api_reads burst=30 nodelay;
        limit_req zone=api_writes burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-PokeTact-Viewer-IP $usage_viewer_ip;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-PokeTact-Origin "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        proxy_cookie_flags pokecoach_session secure httponly samesite=lax;
        # Drop query strings from the access log to avoid recording user questions.
        access_log off;
    }
    location / { return 404; }
}
