# 서버 전용 설정. 실제 비밀 값의 저장소 포함 금지.
# PostgreSQL 상태 저장. 비밀번호는 개인 환경에서 설정하며 URL에는 percent-encoding 적용.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://poketact:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/poketact
DATABASE_SCHEMA=poketact
OPENAI_API_KEY=
# 사용 공급자가 지원하는 구조화 출력 모델 명시.
CHAT_MODEL=
OPENAI_BASE_URL=
# Chroma 로컬 ONNX 임베딩 모델. 첫 색인 시 모델 파일 다운로드 필요.
# 영어 중심 모델이며, 한국어 검색 성능의 별도 평가 필요.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=2
SOURCE_REQUEST_INTERVAL_SECONDS=1
LLM_TIMEOUT_SECONDS=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 연락처 필수 출처에만 실제 관리 연락처 설정. 임의 연락처 생성 금지.
SOURCE_CONTACT=
# 명시적 선택 시에만 원격 프롬프트 추적 활성화.
LANGSMITH_TRACING=false
