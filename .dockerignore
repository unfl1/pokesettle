# Allowlist: credentials, local databases, notes, logs, and captures never enter the build.
**
!deployment/
deployment/*
!deployment/docker/
deployment/docker/*
!deployment/docker/Dockerfile
!pyproject.toml
!uv.lock
!backend/
backend/*
!backend/__init__.py
!backend/app/
!backend/app/**
!backend/scripts/
!backend/scripts/**
!backend/calculator/
backend/calculator/*
!backend/calculator/package.json
!backend/calculator/pnpm-lock.yaml
!backend/calculator/calculate.cjs
!backend/calculator/supported_moves.json
!backend/calculator/LICENSE.smogon-calc
!data/
data/*
!data/pokemon.json
!data/pokemon_names.json
!data/catalog_details.json
!data/battle_names.json
!data/type_chart.json
!data/sources.json
!data/documents/
data/documents/*
!data/documents/species.json
!data/strategy/
data/strategy/*
!data/strategy/notes.json
!data/licenses/
!data/licenses/**
**/__pycache__/
**/*.pyc
**/node_modules/
backend/tests/
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials*.json
**/service-account*.json
**/.npmrc

# Next.js server build inputs only; local output, credentials and test data excluded.
!deployment/docker/Dockerfile.frontend
!frontend/
frontend/*
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/next.config.ts
!frontend/postcss.config.mjs
!frontend/tsconfig.json
!frontend/scripts/
!frontend/scripts/**
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
