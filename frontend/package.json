{
  "name": "pokesettle-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "node ../test/node_modules/@playwright/test/cli.js test --config ../test/frontend/playwright.config.ts",
    "test:public-cache": "node ../test/frontend/verify-public-cache.mjs",
    "prebuild": "node scripts/generate-pokemon-routes.mjs",
    "pretypecheck": "node scripts/generate-pokemon-routes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "16.4.6",
    "@next/third-parties": "16.4.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "7.0.2",
    "@tailwindcss/postcss": "^4.0.0",
    "prettier": "3.9.10",
    "oxlint": "1.90.0"
  },
  "packageManager": "pnpm@11.25.0"
}
