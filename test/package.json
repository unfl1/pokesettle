{
  "name": "pokesettle-tests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "test:deployment": "node --test deployment/*.test.mjs",
    "test:public-cache": "node frontend/verify-public-cache.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "^5.1.0"
  }
}
