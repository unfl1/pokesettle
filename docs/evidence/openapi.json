  "components": {
    "schemas": {
      "BattleInput": {
        "properties": {
          "own": {
            "items": {
              "$ref": "#/components/schemas/TeamMember"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Own"
          },
          "opponent": {
            "items": {
              "$ref": "#/components/schemas/TeamMember"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Opponent"
          },
          "ownActive": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Ownactive",
            "default": 0
          },
          "opponentActive": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Opponentactive",
            "default": 0
          },
          "opponentAttackTypes": {
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "fire",
                "water",
                "electric",
                "grass",
                "ice",
                "fighting",
                "poison",
                "ground",
                "flying",
                "psychic",
                "bug",
                "rock",
                "ghost",
                "dragon",
                "dark",
                "steel",
                "fairy"
              ]
            },
            "type": "array",
            "maxItems": 18,
            "title": "Opponentattacktypes"
          },
          "megaUsed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Megaused"
          },
          "megaTargetId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Megatargetid"
          },
          "switchBlocked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Switchblocked"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "own",
          "opponent"
        ],
        "title": "BattleInput"
      },
      "ChatRequest": {
        "properties": {
          "pokemonId": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Pokemonid"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "regulationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Regulationid"
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid",
            "title": "Clientrequestid"
          },
          "conversationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversationid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pokemonId",
          "question",
          "clientRequestId"
        ],
        "title": "ChatRequest"
      },
      "CollectRequest": {
        "properties": {
          "pokemonId": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Pokemonid"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "regulationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Regulationid"
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid",
            "title": "Clientrequestid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pokemonId",
          "question",
          "clientRequestId"
        ],
        "title": "CollectRequest"
      },
      "ConversationRequest": {
        "properties": {
          "pokemonId": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Pokemonid"
          },
          "regulationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Regulationid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pokemonId"
        ],
        "title": "ConversationRequest"
      },
      "DiscoveryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "regulationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
