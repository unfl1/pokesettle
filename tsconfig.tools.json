{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "k6"],
    "typeRoots": ["./test/node_modules/@types"],
    "paths": {
      "k6": ["./test/node_modules/@types/k6"],
      "k6/*": ["./test/node_modules/@types/k6/*"]
    }
  },
  "include": ["backend/calculator/*.cts", "backend/scripts/*.ts", "deployment/aws/*.ts", "deployment/aws/*.mts"]
}
